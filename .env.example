# --- LLM (at least one key is needed for written answers) ---
# Free key from https://console.groq.com/keys (preferred when set)
GROQ_API_KEY=your_groq_api_key_here
# Optional extra Groq keys, comma-separated, tried in rotation when one is rate limited
GROQ_API_KEYS=
# Optional alternatives, used only when no Groq key is set
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# --- Supabase (Project Settings -> API Keys) ---
# Browser-safe values: these are baked into the frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Server-side only. Never expose this to the browser or commit it
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# --- Service URLs ---
RAG_SERVICE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
PORT=3001
# Comma-separated origins allowed to call the RAG service (default: all)
ALLOWED_ORIGINS=

# --- Contact form email alert (optional; messages are stored in Supabase either way) ---
# Where alerts go (comma-separated). For Gmail use an App Password, not your normal password
CONTACT_NOTIFY_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
