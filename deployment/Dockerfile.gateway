# Use Node.js as the base image
FROM node:20-slim AS base

# Stage 1: Build Frontend
FROM base AS frontend-builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
# The browser talks to the gateway on the same origin; Supabase values come from build args.
# Environment variables take precedence over .env in Vite, so a local .env cannot leak in.
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ENV VITE_API_URL=/api/v1     VITE_SUPABASE_URL=$VITE_SUPABASE_URL     VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY
RUN npm run build

# Stage 2: Final Image
FROM base
WORKDIR /app

# Copy built frontend
COPY --from=frontend-builder /app/dist ./dist

# Set up server
WORKDIR /app/server
COPY server/package*.json ./
RUN npm install --production
COPY server/ .

# Environment variables
ENV PORT=3001
ENV NODE_ENV=production

EXPOSE 3001

CMD ["node", "index.js"]
