# Use Python 3.11 as the base image
FROM python:3.11-slim

# Install system dependencies (for OCR/PDF processing)
RUN apt-get update && apt-get install -y \
    tesseract-ocr \
    libtesseract-dev \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/rag_service

# Copy requirements and install
COPY rag_service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the RAG service
COPY rag_service/ .

# Copy .env from root if needed (or use environment variables in compose)
# COPY .env ../.env

# Environment variables
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
